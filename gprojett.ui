         <string notr="true">QComboBox {
    background-color: rgba(0, 0, 0, 100);
    border: 2px solid rgba(0, 0, 0, 100);
    border-radius: 8px;
    padding: 5px;
    color: white;
    font-size: 14px;
}

QComboBox:hover {
    background-color: rgba(0, 0, 0, 80); /* Léger éclaircissement au survol */
    border: 2px solid rgba(0, 0, 0, 120);
}

QComboBox:focus {
    border: 2px solid rgba(0, 0, 0, 150);
    background-color: rgba(0, 0, 0, 120);
}

QComboBox::drop-down {
    width: 20px;
    border-left: 2px solid rgba(255, 255, 255, 50);
}

QComboBox::down-arrow {
    image: url(C:/Users/benha/OneDrive/Bureau/GProjett/icon/down1.png); /* Remplace par ton icône */
    width: 12px;
    height: 12px;
}

QComboBox QAbstractItemView {
    background-color: rgba(0, 0, 0, 100);
    border: 2px solid rgba(0, 0, 0, 150);
    selection-background-color: rgba(255, 255, 255, 50);
    selection-color: white;
    color: white;
}

QComboBox QAbstractItemView::item {
    padding: 5px;
    border-radius: 4px;
}

QComboBox QAbstractItemView::item:hover {
    background-color: rgba(255, 255, 255, 50);
}
