        <property name="styleSheet">
         <string notr="true">QDateEdit {
    background-color: rgba(0, 0, 0, 100);
    border: 2px solid rgba(0, 0, 0, 100);
    border-radius: 8px;
    padding: 5px;
    selection-background-color: rgba(0, 0, 0, 100);
    selection-color: white;
    font-size: 14px;
    color: white; /* Texte blanc pour contraste */
}

QDateEdit:hover {
    background-color: rgba(0, 0, 0, 80); /* Léger éclaircissement au survol */
    border: 2px solid rgba(0, 0, 0, 120);
}

QDateEdit:focus {
    border: 2px solid rgba(0, 0, 0, 150); /* Plus intense en focus */
    background-color: rgba(0, 0, 0, 120);
}

QDateEdit::drop-down {
    width: 20px;
    border-left: 2px solid rgba(255, 255, 255, 50);
}

QDateEdit::down-arrow {
    image: url(:/icons/down_arrow.png); /* Remplace par ton icône */
    width: 12px;
    height: 12px;
}

QDateEdit::up-button, QDateEdit::down-button {
    width: 16px;
    height: 16px;
    background-color: rgba(255, 255, 255, 50); /* Gris clair semi-transparent */
    border-radius: 4px;
}

QDateEdit::up-button:hover, QDateEdit::down-button:hover {
    background-color: rgba(255, 255, 255, 100);
}

QDateEdit::up-arrow {
