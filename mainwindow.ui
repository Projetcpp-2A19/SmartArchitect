     <widget class="QTableView" name="tableViewFournisseurs">
      <property name="geometry">
       <rect>
        <x>20</x>
        <y>410</y>
        <width>731</width>
        <height>221</height>
       </rect>
      </property>
      <property name="styleSheet">
       <string notr="true">QTableView {
    background-color: #f0f0f0;  /* Couleur de fond de la table */
    alternate-background-color: #e0e0e0;  /* Couleur de fond des lignes alternées */
    gridline-color: #c0c0c0;  /* Couleur des lignes de la grille */
    border: 1px solid #a0a0a0;  /* Bordure de la table */
    border-radius: 5px;  /* Coins arrondis */
    font-family: &quot;Arial&quot;;  /* Police de caractères */
    font-size: 12px;  /* Taille de la police */
}

QTableView::item {
    padding: 5px;  /* Espacement interne des cellules */
    color: #333333;  /* Couleur du texte */
    background-color: #ffffff;  /* Couleur de fond des cellules */
}

QTableView::item:selected {
    background-color:rgba(0, 0, 0, 100);  /* Couleur de fond des cellules sélectionnées */
    color: #ffffff;  /* Couleur du texte des cellules sélectionnées */
}

QHeaderView::section {
    background-color:rgba(0, 0, 0, 100);  /* Couleur de fond des en-têtes de colonnes */
    color: #ffffff;  /* Couleur du texte des en-têtes de colonnes */
    padding: 5px;  /* Espacement interne des en-têtes */
    border: 1px solid #005bb5;  /* Bordure des en-têtes */
    font-weight: bold;  /* Texte en gras */
}

QHeaderView::section:checked {
   background-color:rgba(0, 0, 0, 100);  /* Couleur de fond des en-têtes sélectionnés */
}

QTableView QTableCornerButton::section {
   background-color:rgba(0, 0, 0, 100);  /* Couleur de fond du coin de la table */
    border: 1px solid #005bb5;  /* Bordure du coin de la table */
}</string>
      </property>
